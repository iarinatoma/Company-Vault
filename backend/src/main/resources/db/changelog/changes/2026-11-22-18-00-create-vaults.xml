<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Vaults: general (company-wide, created by admins), personal (one per user) and project
         vaults share one table; type tells them apart. Access is in access_grants and the vault's
         data key in data_keys, both with resource_type VAULT. created_by has no foreign key on
         purpose, so deleting a user never blocks on the vaults they created. -->
    <changeSet id="2026-11-22-18-00-create-vaults" author="iarina-toma">
        <createTable tableName="vaults">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="type" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="archived" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="uuid"/>
        </createTable>
        <createIndex tableName="vaults" indexName="ix_vaults_type">
            <column name="type"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>