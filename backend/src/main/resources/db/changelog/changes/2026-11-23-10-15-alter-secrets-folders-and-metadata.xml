<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-11-23-10-15-alter-secrets-folders-and-metadata" author="andreea">
        <addColumn tableName="secrets">
            <column name="folder_id" type="uuid">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="varchar(1000)"/>
            <column name="tags" type="text"/>
            <column name="expires_at" type="timestamptz"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="secrets"
                                 baseColumnNames="folder_id"
                                 constraintName="fk_secrets_folder"
                                 referencedTableName="folders"
                                 referencedColumnNames="id"
                                 onDelete="SET NULL"/>

        <createIndex tableName="secrets" indexName="ix_secrets_vault_folder">
            <column name="vault_id"/>
            <column name="folder_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>