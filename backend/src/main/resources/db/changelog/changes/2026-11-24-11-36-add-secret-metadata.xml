<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Spec 4.3 metadata: optional description, normalized tags and optional expiration timestamp.
         Owner (created_by) and timestamps (created_at, updated_at) already exist on secrets. -->
    <changeSet id="2026-11-24-11-36-add-secret-metadata" author="andreea">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="secrets" columnName="description"/>
            </not>
        </preConditions>
        <addColumn tableName="secrets">
            <column name="description" type="varchar(1000)"/>
            <column name="tags" type="text"/>
            <column name="expires_at" type="timestamptz"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>