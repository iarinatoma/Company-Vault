<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Secrets: the name is plain text so it can be listed and searched without decrypting
         anything (spec 4.3); the value is stored only encrypted with the vault's data key
         (AES-256-GCM, base64 of nonce || ciphertext || tag). created_by is the owner (spec 4.3
         metadata); created_by/updated_by have no foreign key so deleting a user never blocks. -->
    <changeSet id="2026-11-22-23-30-create-secrets" author="iarina-toma">
        <createTable tableName="secrets">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="vault_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_secrets_vault"
                             references="vaults(id)"/>
            </column>
            <column name="name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_value" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="uuid"/>
            <column name="updated_by" type="uuid"/>
        </createTable>
        <createIndex tableName="secrets" indexName="ix_secrets_vault">
            <column name="vault_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>