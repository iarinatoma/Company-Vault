<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Secret types (spec 4.3): LOGIN, API_KEY, NOTE, CUSTOM. The type is plain metadata; existing
         secrets have just one value, so they become API_KEY. encrypted_fields holds the
         type-specific fields (username, URL, custom key-value fields) as JSON, encrypted with the
         vault's data key like encrypted_value; null when a secret has none. -->
    <changeSet id="2026-11-24-21-00-add-secret-type-and-fields" author="mihai-dreghiciu">
        <addColumn tableName="secrets">
            <column name="type" type="varchar(20)" defaultValue="API_KEY">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_fields" type="text"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>