DB_PASSWORD=
JWT_SECRET=
# Master key: base64 of exactly 32 random bytes. Never commit it.
# Alternative on a server: put it in a file named ENCRYPTION_KEY inside SECRETS_DIR (default /run/secrets/).
ENCRYPTION_KEY=
# Only during a master key rotation: the old key, so data under it stays readable (see README).
ENCRYPTION_KEY_PREVIOUS=
PASSWORD_SETUP_LINK_BASE_URL=http://localhost:4200/reset-password
EMAIL_ENABLED=true
EMAIL_FROM=noreply@company-vault.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false